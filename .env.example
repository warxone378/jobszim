# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Flask session/CSRF signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value

# Gmail (or other SMTP) account used to send password-reset and
# notification emails via Flask-Mail.
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Google reCAPTCHA secret key, used to verify form submissions.
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
